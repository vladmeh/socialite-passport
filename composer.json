{
    "name": "vladmeh/socialite-passport",
    "description": "Passport Laravel Socialite Provider",
    "license": "MIT",
    "keywords": ["Laravel", "oAuth", "Passport", "Socialite"],
    "homepage": "https://github.com/vladmeh/socialite-passport",
    "authors": [
        {
            "name": "Mikhaylov.V",
            "email": "vladmeh@gmail.com"
        }
    ],
    "require": {
        "php": "^7.2",
        "ext-json": "*",
        "laravel/socialite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.0|^8.0",
        "orchestra/testbench": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Vladmeh\\Socialite\\" : "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vladmeh\\Socialite\\Tests\\" : "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vladmeh\\Socialite\\SocialiteServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
